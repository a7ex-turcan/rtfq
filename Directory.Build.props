<Project>

  <PropertyGroup>
    <!--
      The single source of truth for the version. Local and CI builds carry the
      "dev" suffix so a binary from a working tree can never be mistaken for a
      release; the release workflow overrides Version from the git tag, so the
      number the CLI reports is exactly the tag that produced it.
    -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>

    <Authors>Alex Turcan</Authors>
    <Product>RTFQ</Product>
    <RepositoryUrl>https://github.com/a7ex-turcan/rtfq</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      ADR 0001: a trimmed reflection walk turned the statement guard into a
      fail-open gate while every JIT test still passed. Trim and AOT warnings
      are therefore build failures here, not advisories.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <!-- Product code must stay AOT-clean. Test projects need not. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

</Project>
